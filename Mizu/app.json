{
  "expo": {
    "name": "Mizu",
    "slug": "mizu-hidratacao",
    "version": "1.3.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mizu.hidratacao",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "O Mizu usa notificações para lembrar você de beber água dentro da sua rotina."
      }
    },
    "android": {
      "package": "com.mizu.hidratacao",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A8DADC",
          "defaultChannel": "mizu-lembretes"
        }
      ]
    ]
  }
}
